# Copy this file to server/.env and fill in values for local development.
# Never commit real secret keys.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Local MongoDB or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/mithila-ghar

# Set to true if MongoDB is not installed. Uses an in-memory database for demos/tests.
USE_MEMORY_DB=true

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Stripe TEST keys only. Never use live keys for this university project.
# Get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Stripe may not accept NPR on every account. The app stores prices in NPR
# and converts to this Stripe currency for card tests.
STRIPE_CURRENCY=usd
NPR_PER_USD=133

# eSewa TEST/sandbox credentials (official test merchant is publicly documented)
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/

SHIPPING_FEE=150
FREE_SHIPPING_THRESHOLD=2000
